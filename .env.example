# MemoDirector Environment Variables
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your actual API keys below
# 3. Never commit the .env file to Git!

# ============================================
# LLM Provider Configuration
# ============================================
# Choose ONE provider by setting its API key/URL
# Priority: Gemini > OpenAI > OpenRouter > Ollama

# Google Gemini (Recommended - supports image/video generation)
# Get your key from: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-2.5-flash

# OpenAI (GPT models)
# Get your key from: https://platform.openai.com/api-keys
# VITE_OPENAI_API_KEY=your_openai_api_key_here
# VITE_OPENAI_MODEL=gpt-4o-mini

# OpenRouter (Access to multiple models)
# Get your key from: https://openrouter.ai/keys
# VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here
# VITE_OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Ollama (Local LLM - no API key needed)
# Install from: https://ollama.ai
# VITE_OLLAMA_BASE_URL=http://localhost:11434
# VITE_OLLAMA_MODEL=llama3.2

# ============================================
# Firebase Configuration (OPTIONAL)
# ============================================
# Get these from: https://console.firebase.google.com/
# If you skip this, the app will use LocalStorage instead
# 
# Note: If you get ERR_BLOCKED_BY_CLIENT errors:
# - Whitelist firestore.googleapis.com in your ad blocker, OR
# - Comment out these lines to use LocalStorage only

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
