# MemoDirector Environment Variables
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your actual API keys below
# 3. Never commit the .env file to Git!

# ============================================
# Google Gemini API Key (REQUIRED)
# ============================================
# Get your key from: https://aistudio.google.com/apikey
# This is required for AI-powered PAO suggestions
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# Firebase Configuration (OPTIONAL)
# ============================================
# Get these from: https://console.firebase.google.com/
# If you skip this, the app will use LocalStorage instead
# 
# Note: If you get ERR_BLOCKED_BY_CLIENT errors:
# - Whitelist firestore.googleapis.com in your ad blocker, OR
# - Comment out these lines to use LocalStorage only

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
