# MemoDirector Environment Variables
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your actual API keys below
# 3. Never commit the .env file to Git!

# ============================================
# LLM Provider Configuration
# ============================================
# Choose ONE provider by setting its API key/URL
# Priority: Gemini > OpenAI > OpenRouter > Ollama

# Google Gemini (Recommended - supports image/video generation)
# Get your key from: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-2.5-flash

# OpenAI (GPT models)
# Get your key from: https://platform.openai.com/api-keys
# VITE_OPENAI_API_KEY=your_openai_api_key_here
# VITE_OPENAI_MODEL=gpt-4o-mini

# OpenRouter (Access to multiple models)
# Get your key from: https://openrouter.ai/keys
# VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here
# VITE_OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Ollama (Local LLM - no API key needed)
# Install from: https://ollama.ai
# VITE_OLLAMA_BASE_URL=http://localhost:11434
# VITE_OLLAMA_MODEL=llama3.2

# ============================================
# Firebase Configuration (REQUIRED for Multi-User)
# ============================================
# Get these from: https://console.firebase.google.com/
# 
# IMPORTANT: Firebase is now REQUIRED for multi-user support
# - Each user gets their own isolated data space
# - Authentication prevents data conflicts
# - Syncs across user's devices
# 
# Setup Steps:
# 1. Create a Firebase project at https://console.firebase.google.com/
# 2. Enable Authentication (Email/Password and Google Sign-In)
# 3. Enable Firestore Database
# 4. Deploy the firestore.rules file for security
# 5. Copy your config values below
# 
# Note: If you get ERR_BLOCKED_BY_CLIENT errors:
# - Whitelist firestore.googleapis.com in your ad blocker

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ============================================
# IMPORTANT: API Keys are Now User-Managed
# ============================================
# AI provider API keys are NO LONGER set here!
# Users must add their own keys in the app:
# Settings → API Keys
# 
# This ensures:
# - User privacy (keys never sent to server)
# - User control (use their own keys)
# - Security (keys stored locally only)
# 
# The environment variables below are only for
# development/testing purposes and will be
# overridden by user-provided keys.
